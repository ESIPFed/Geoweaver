<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- Define the pattern for log output -->
    <property name="LOG_PATTERN" value="%d{yyyy-MM-dd HH:mm:ss} %-5level %logger{36} - %msg%n" />

    <!-- Define the log file location -->
    <property name="LOG_FILE" value="${user.home}/geoweaver/logs/geoweaver.log" />

    <!-- Console appender configuration -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <!-- commands set WARN so their output is not buried in start-up messages -->
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>${GEOWEAVER_CONSOLE_LOG_LEVEL:-INFO}</level>
        </filter>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <!-- File appender configuration -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_FILE}</file>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
        <immediateFlush>true</immediateFlush>
        <append>true</append>
        <!-- daily files, split at 50 MB, 30 days and at most 300 MB in total, so the log folder
             stays small on home folders with a quota even on a very busy day -->
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${user.home}/geoweaver/logs/geoweaver.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>50MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>300MB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <!-- Set the root logger level and attach appenders -->
    <root level="INFO">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="FILE" />
    </root>

</configuration>
