#!/usr/bin/env bash
# One command: open OOD Geoweaver, save session cookies for Cursor (no chat paste).
# Usage:
#   ./scripts/gw-ood-login 'https://ondemand…/rnode/HOST/PORT/Geoweaver/web/geoweaver'
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
URL="${1:-}"

if [[ -z "$URL" ]]; then
  echo "Usage: $0 '<Open-OnDemand-Geoweaver-Connect-URL>'" >&2
  echo "Example: $0 'https://ondemand.example.edu/rnode/HOST/PORT/Geoweaver/web/geoweaver'" >&2
  exit 1
fi

if ! command -v python3 >/dev/null 2>&1; then
  echo "python3 is required" >&2
  exit 1
fi

# First-run: install Playwright + Chromium quietly if missing
if ! python3 -c "import playwright" 2>/dev/null; then
  echo "Installing Playwright (one-time)…"
  python3 -m pip install -q playwright
fi
if ! python3 -c "from playwright.sync_api import sync_playwright" 2>/dev/null; then
  echo "Playwright import failed after pip install" >&2
  exit 1
fi
# Ensure browser binary exists (cheap if already installed)
python3 -m playwright install chromium >/dev/null 2>&1 || \
  python3 -m playwright install chromium

python3 "$ROOT/scripts/capture-ood-session.py" --engine playwright "$URL"

ENV_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/geoweaver-agent/ood-env.sh"
echo ""
echo "Done. In this shell (or tell Cursor these paths exist — do not paste cookie contents):"
echo "  source $ENV_FILE"
echo "Then mint a Geoweaver Bearer against \$GEOWEAVER_BASE_URL if you do not have one yet."
